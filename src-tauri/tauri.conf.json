{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetFlow",
  "version": "2.0.0",
  "identifier": "com.netflow.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NetFlow",
        "width": 1100,
        "height": 700,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0d0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
